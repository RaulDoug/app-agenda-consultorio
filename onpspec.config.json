{
  "testCommand": "npm test",
  "reporter": "tap",
  "testGlobs": [
    "backend/test/**",
    "backend/tests/**",
    "backend/src/**/*.test.*",
    "backend/src/**/*.spec.*",
    "frontend/test/**",
    "frontend/tests/**",
    "frontend/src/**/*.test.*",
    "frontend/src/**/*.spec.*",
    "shared/src/**/*.test.*",
    "shared/src/**/*.spec.*",
    "test/**",
    "tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "__tests__/**"
  ],
  "srcGlobs": [
    "backend/src/**",
    "frontend/src/**",
    "shared/src/**",
    "src/**"
  ]
}
