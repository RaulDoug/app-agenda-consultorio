{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "..",
    "paths": {
      "@odontoflow/shared": ["../shared/src/index.ts"],
      "@odontoflow/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "tests/**/*", "scripts/**/*", "../shared/src/**/*"]
}
