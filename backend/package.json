{
  "name": "@cliniassist/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST Backend do CliniAssist (Node.js + Express.js + PostgreSQL via pg + BullMQ + Evolution API)",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch --env-file=.env src/app.ts",
    "start": "npx tsx --env-file=.env src/app.ts",
    "test:confirmation": "npx tsx --env-file=.env scripts/test-confirmation-flow.ts",
    "db:migrate": "npx tsx --env-file=.env scripts/db-migrate.ts",
    "user:create": "npx tsx --env-file=.env scripts/user-create.ts",
    "user:reset-password": "npx tsx --env-file=.env scripts/user-reset-password.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cliniassist/shared": "*",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.16",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ioredis-mock": "^8.13.1",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1"
  }
}
