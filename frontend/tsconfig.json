{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@cliniassist/shared": ["../shared/src/index.ts"],
      "@cliniassist/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "tests/**/*"]
}
