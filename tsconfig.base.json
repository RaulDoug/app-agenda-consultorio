{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@odontoflow/shared": ["./shared/src/index.ts"],
      "@odontoflow/shared/*": ["./shared/src/*"]
    }
  }
}
