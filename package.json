{
  "name": "cliniassist-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo do sistema CliniAssist — Gestão Ágil de Agenda, Confirmações WhatsApp e Caixa para Profissionais Autônomos e Clínicas",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:confirmation": "npm run test:confirmation --workspace=backend",
    "spec:status": "node .agents/skills/onp-spec-driven/scripts/onp-spec.mjs status",
    "spec:audit": "node .agents/skills/onp-spec-driven/scripts/onp-spec.mjs audit --ci"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
